# Local development: talk to the backend running on your own machine
# (cd backend && npm run dev). Must end in /api.
VITE_API_URL=http://localhost:5000/api

# Deployed backend — use your backend project's permanent production domain
# (Vercel → backend project → Domains), not a per-deployment
# "backend-xxxx-...vercel.app" URL, which is login-protected. Must end in /api.
# VITE_API_URL=https://backend-kqiwdjbku-kulsoomamjad-12s-projects.vercel.app/api
