# Used by `npm run build` (the Vercel deploy).
#
# VITE_API_URL is NOT set here on purpose — set it in Vercel:
#   frontend project -> Settings -> Environment Variables
#   VITE_API_URL = https://<your backend's production domain>/api
# then redeploy. Vercel's variables override this file.
VITE_PUBLIC_SITE_URL=https://sentira-project-frontend.vercel.app
